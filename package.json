{
  "name": "pptx-json-parser",
  "version": "1.0.1",
  "description": "Parse PPTX files to structured JSON data for rendering in any framework",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "pptx",
    "powerpoint",
    "parser",
    "presentation",
    "slides",
    "office",
    "framework-agnostic"
  ],
  "author": "lurengu <2841816585@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ccccc-spec/PPTX-parser.git"
  },
  "homepage": "https://github.com/Ccccc-spec/PPTX-parser#readme",
  "bugs": {
    "url": "https://github.com/Ccccc-spec/PPTX-parser/issues"
  },
  "dependencies": {
    "pptxtojson": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
